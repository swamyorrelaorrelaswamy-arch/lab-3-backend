{
  "info": {
    "name": "Lab 3 - Books REST API",
    "description": "30 requests for Lab 3: REST API, query parameters, validation and debugging. Run the collection in order with Run collection. Request 09 saves the new book id in the collection variable newBookId, and request 12 deletes that book again, so the database holds the same 9 rows before and after the run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 GET all books (defaults)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Body is a JSON array with the 9 seeded books\", function () {",
              "  const books = pm.response.json();",
              "  pm.expect(books).to.be.an(\"array\");",
              "  pm.expect(books).to.have.lengthOf(9);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books/"
      }
    },
    {
      "name": "02 GET one book",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Body is the book with ID 3\", function () {",
              "  const book = pm.response.json();",
              "  pm.expect(book.id).to.eql(3);",
              "  pm.expect(book.title).to.eql(\"Eloquent JavaScript\");",
              "  pm.expect(book).to.have.all.keys(\"id\", \"title\", \"author\", \"price\", \"pages\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books/3/"
      }
    },
    {
      "name": "03 Search by title (search_q=the)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Returns the 3 titles that contain 'the'\", function () {",
              "  const books = pm.response.json();",
              "  pm.expect(books).to.be.an(\"array\");",
              "  pm.expect(books).to.have.lengthOf(3);",
              "  books.forEach(function (book) {",
              "    pm.expect(book.title.toLowerCase()).to.include(\"the\");",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books/?search_q=the"
      }
    },
    {
      "name": "04 Sort by price descending (limit=5)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Returns 5 books sorted by price from high to low\", function () {",
              "  const books = pm.response.json();",
              "  pm.expect(books).to.have.lengthOf(5);",
              "  pm.expect(books[0].price).to.eql(750);",
              "  pm.expect(books[4].price).to.eql(500);",
              "  for (let i = 1; i < books.length; i++) {",
              "    pm.expect(books[i - 1].price).to.be.at.least(books[i].price);",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books/?order_by=price&order=DESC&limit=5"
      }
    },
    {
      "name": "05 Pagination (limit=3, offset=3)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Returns 3 books starting from the 4th row\", function () {",
              "  const books = pm.response.json();",
              "  pm.expect(books).to.have.lengthOf(3);",
              "  pm.expect(books.map(function (book) { return book.id; })).to.eql([4, 5, 6]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books/?limit=3&offset=3"
      }
    },
    {
