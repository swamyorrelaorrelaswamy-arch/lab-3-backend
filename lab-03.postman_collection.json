              "});",
              "",
              "pm.test(\"Returns only books priced from 250 to 400\", function () {",
              "  const books = pm.response.json();",
              "  pm.expect(books).to.have.lengthOf(3);",
              "  books.forEach(function (book) {",
              "    pm.expect(book.price).to.be.at.least(250);",
              "    pm.expect(book.price).to.be.at.most(400);",
